# Sekrety i konfiguracja lokalne (NIGDY nie commituj .env)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Provider LLM: domyślnie "vibe" (lokalny CLI), gdy binary vibe w PATH.
# LLM_PROVIDER=stub wyłącza LLM (czysty determinizm).
# LLM_PROVIDER=vibe

# Modele (aliasy z katalogu vibe): fast = zai-glm-5-3-flash, strong = mistral-large-4-0
# VIBE_FAST_MODEL=zai-glm-5-3-flash
# VIBE_STRONG_MODEL=mistral-large-4-0

# Narzędzia dla bota LLM (źródło uruchamiania Pythona przez vibe CLI):
# domyślnie __none__ = bot NIE może wykonywać kodu (bezpieczne; silnik robi robotę).
# Żeby bot mógł sam uruchamiać Pythona:
# VIBE_ENABLED_TOOLS=file_system.bash,file_system.read,file_system.write
# VIBE_APPROVAL_POLICY=smart-approve   # lub auto-approve (ostrożnie!)

# Health monitor co ile sekund ma sprawdzać projekty (domyślnie 300)
# HEALTH_INTERVAL=300

# Automatyczne powiadomienia push o statusach zadań (0 = wyłączone, Sponsor klika sam w menu; 1 = włączone)
TELEGRAM_PUSH=0
# Bramka 7b Deploy Prod na Telegramie (1 = włączona, 0 = wyłączona)
TELEGRAM_DEPLOY_GATE=1
